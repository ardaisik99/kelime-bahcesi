{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamlama-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_HUB",
        "class_name": "RoomHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomHub"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
